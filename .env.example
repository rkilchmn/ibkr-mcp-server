# .env.example
IB_GATEWAY_USERNAME=your_username
IB_GATEWAY_VNC_PORT=5900
# VNC password (enables x11vnc inside the gateway container when set).
# Can also use --vnc-password-file or VNC_PASSWORD_FILE env var instead.
# IB_GATEWAY_VNC_PASSWORD=your_vnc_password
# VNC_PASSWORD_FILE=~/.secrets/ibkr/vnc_password
# Password file path (defaults to ~/.secrets/ibkr/<USERNAME> if not set)
# IB_GATEWAY_PASSWORD_FILE=~/.secrets/ibkr/your_username
# Fallback: direct password (less secure, override if no password file)
# IB_GATEWAY_PASSWORD=your_password

# Timeout configuration (in seconds)
IB_CONNECTION_TIMEOUT=30
IB_GATEWAY_TIMEOUT=300
IB_REQUEST_TIMEOUT=30

# Optional: MCP server port (default: 8000, or MCP_PORT env var)
MCP_PORT=8000

# Docker image for IBKR Gateway (default: ghcr.io/gnzsnz/ib-gateway:latest)
# IB_GATEWAY_IMAGE=ghcr.io/gnzsnz/ib-gateway:latest

# Host port for container-side RDP (default: 3389)
# TWS_RDP_PORT=3389

# Optional: host path to the abc_password secret file.
# Default: ~/.secrets/ib-gateway/abc_password (or <IB_GATEWAY_CREDENTIALS_PATH>/abc_password)
# PASSWORD_FILE=~/.secrets/ib-gateway/abc_password

# IBKR Gateway read-only API mode (default: true)
# Can also use --read-only-api=false CLI arg
READ_ONLY_API=true

# Logging configuration
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO

# Optional: host path for credential files (default: ~/.secrets/ib-gateway, or IB_GATEWAY_CREDENTIALS_PATH env var)
# IB_GATEWAY_CREDENTIALS_PATH=~/.secrets/ib-gateway

# Optional: base directory for config/ and .docker/ (default: ib-gateway-data in current dir, or IB_GATEWAY_DATA_PATH env var)
# IB_GATEWAY_DATA_PATH=ib-gateway-data

# Optional: host path for TWS settings persistence (default: ./tws_settings for ib-gateway, ./config for tws-rdesktop)
# IB_GATEWAY_TWS_SETTINGS_PATH=./tws_settings
