# .env.example
IB_GATEWAY_USERNAME=your_username
IB_GATEWAY_VNC_PORT=5900
# Password file path (defaults to ~/.secrets/ibkr/<USERNAME> if not set)
# IB_GATEWAY_PASSWORD_FILE=~/.secrets/ibkr/your_username
# Fallback: direct password (less secure, override if no password file)
# IB_GATEWAY_PASSWORD=your_password

# Timeout configuration (in seconds)
IB_CONNECTION_TIMEOUT=30
IB_GATEWAY_TIMEOUT=300
IB_REQUEST_TIMEOUT=30

# Logging configuration
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO
